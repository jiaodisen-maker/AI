# Copy to .env, fill, never commit. See SAAS-VS-SELFBUILD.md §5.

# ===== 飞书开放平台 =====
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=___PUT_IN_KMS_NOT_HERE___
FEISHU_VERIFICATION_TOKEN=___FROM_FEISHU_OPEN_PLATFORM___
FEISHU_ENCRYPT_KEY=___FROM_FEISHU_OPEN_PLATFORM___
FEISHU_DELIVERY_MODE=webhook    # webhook | long_connection

# ===== Coze 企业旗舰版 =====
COZE_API_BASE=https://api.coze.cn
COZE_PAT=___PUT_IN_KMS_NOT_HERE___
COZE_ENTERPRISE_ID=enterprise_xxxxxxxxxxx

# Coze 资源 ID（在扣子后台复制）
COZE_PERSONAL_ASSISTANT_BOT_ID=
COZE_MEETING_DIGEST_BOT_ID=
COZE_APPROVAL_HANDLER_BOT_ID=
COZE_PRODUCT_KB_DATASET_ID=
COZE_SOP_KB_DATASET_ID=
COZE_MEETING_TRANSCRIPTS_KB_DATASET_ID=
COZE_MEETING_DIGEST_WORKFLOW_ID=

# ===== 队列 / 去重 =====
REDIS_URL=redis://redis:6379/0
QUEUE_STREAM=feishu:events
QUEUE_DLQ=feishu:events:dlq
QUEUE_GROUP=bridge-workers
IDEMPOTENCY_TTL_SECONDS=3600

# ===== 重试 =====
MAX_RETRIES=5
BACKOFF_BASE_MS=1000

# ===== 服务监听 =====
BIND_HOST=0.0.0.0
BIND_PORT=8810

# ===== 监控 =====
PROMETHEUS_PORT=9100
FEISHU_ALERT_WEBHOOK=___OPS_GROUP_BOT_WEBHOOK___

# ===== 审计 =====
AUDIT_LOG_DIR=/var/log/feishu-coze-bridge
DATABASE_URL=postgresql://bridge:CHANGE_ME@postgres:5432/bridge
