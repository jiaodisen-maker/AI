# ============================================
# AI 中台 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- 基础配置 ----------
APP_NAME=ai-zhongtai
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string

# ---------- LLM 模型配置 ----------
# 本地模型 (vLLM)
LOCAL_MODEL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL_NAME=qwen2.5-72b-instruct
LOCAL_MODEL_API_KEY=not-needed

# 海外模型
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# 默认模型路由策略: local_first / overseas_first / cost_optimized
MODEL_ROUTING_STRATEGY=local_first

# ---------- 数据库 ----------
DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/ai_zhongtai
REDIS_URL=redis://localhost:6379/0

# ---------- 向量数据库 ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---------- ClickHouse ----------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=analytics

# ---------- 飞书配置 ----------
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx
FEISHU_ENCRYPT_KEY=xxx

# ---------- 文件存储 ----------
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=xxx
OSS_ACCESS_KEY_SECRET=xxx
OSS_BUCKET=ai-zhongtai

# ---------- 巡逻系统 ----------
PATROL_ENABLED=true
PATROL_TIMEZONE=Asia/Shanghai
