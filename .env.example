# ============================================================
# 飞书集成
# ============================================================
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
LARK_VERIFICATION_TOKEN=xxx
LARK_ENCRYPT_KEY=                          # 加密事件用，可空

# ============================================================
# 服务地址
# ============================================================
AGENT_ROUTER_URL=http://agent-router:8000

# ============================================================
# Adapter 选择（架构主权 — 改这里就能换框架）
# ============================================================
AGENT_FRAMEWORK=mock                       # mock | agentscope_1x | langgraph
REGISTRY_TYPE=local                        # local | (未来 himarket)
SESSION_TYPE=redis                         # mock | redis
MEMORY_TYPE=redis                          # mock | redis
SKILL_TYPE=filesystem                      # filesystem

# ============================================================
# 数据层
# ============================================================
REGISTRY_REDIS_URL=redis://agent-registry-redis:6379
SESSION_REDIS_URL=redis://session-redis:6379
MEMORY_REDIS_URL=redis://memory-redis:6379

# ============================================================
# Skill 文件系统
# ============================================================
SKILLS_DIR=/data/skills

# ============================================================
# 中间件开关
# ============================================================
ENABLE_PII=true                            # PII 自动脱敏（手机/邮箱/身份证/银行卡）
ENABLE_COMPLIANCE=true                     # 禁词扫描
ENABLE_EXPERIENCE=true                     # 经验引擎注入
COMPLIANCE_BLOCK_INPUT=false               # true=输入有禁词直接拦截
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_DAY=1000

# ============================================================
# Session 配置
# ============================================================
SESSION_TTL=604800                         # 7 天
SESSION_MAX_MESSAGES=100                   # 单 session 保留消息数

# ============================================================
# LLM 配置（当 AGENT_FRAMEWORK=langgraph 时用）
# ============================================================
DEFAULT_LLM_MODEL=qwen-max
LLM_API_BASE=                              # OpenAI 兼容 API（如 LiteLLM Proxy）
LLM_API_KEY=
DASHSCOPE_API_KEY=                         # AgentScope 1.x 用 Qwen 时

# ============================================================
# 日志/调试
# ============================================================
LOG_LEVEL=INFO
DEBUG=true                                 # 启用 /debug/message 接口
