# Postgres
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentic-insight

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_BUCKET=cases-media

# Redis
REDIS_URL=redis://localhost:6379/0

# ==================================================================
# LLM 配置（两选一）
# ==================================================================
#
# 方式 A：聚合端点（推荐）— OpenAI 兼容，所有模型走同一 base_url + key
#   适用：dataeyes / OpenRouter / 自建 LiteLLM proxy 等
#   设置以下两个，其它 LLM 单独 key 全部忽略：
LLM_BASE_URL=
LLM_API_KEY=
#
# 方式 B：分别配置（fallback）— 不设 LLM_BASE_URL 时启用
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=
#
# 可选 override：单独覆盖某个模型的 base_url
DEEPSEEK_BASE_URL=
QWEN_BASE_URL=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=                 # 默认 text-embedding-v3

# Douyin / Juliang (fill in via OAuth flow)
DOUYIN_OAUTH_CLIENT_ID=
DOUYIN_OAUTH_CLIENT_SECRET=
QIANCHUAN_API_KEY=

# v6 feature flags
# 默认 false（production 安全姿态）。内部研究环境在自己的 .env 里 override 为 true，
# 且必须先签字归档 docs/poc-research-memorandum-template.md
POC_CRAWLED_ENABLED=false
POC_DATA_TTL_DAYS=30
POC_RATE_LIMIT_SEC=3.0
HITL_WEBHOOK_URL=               # 钉钉 / 企业微信 robot webhook（IM 仅通知，数据不持久化在 IM）
