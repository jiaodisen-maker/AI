# Postgres
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentic-insight

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_BUCKET=cases-media

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM keys (fill in real values, never commit)
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=

# Douyin / Juliang (fill in via OAuth flow)
DOUYIN_OAUTH_CLIENT_ID=
DOUYIN_OAUTH_CLIENT_SECRET=
QIANCHUAN_API_KEY=

# v6 feature flags
# 默认 false（production 安全姿态）。内部研究环境在自己的 .env 里 override 为 true，
# 且必须先签字归档 docs/poc-research-memorandum-template.md
POC_CRAWLED_ENABLED=false
POC_DATA_TTL_DAYS=30
POC_RATE_LIMIT_SEC=3.0
HITL_WEBHOOK_URL=               # 钉钉 / 企业微信 robot webhook（IM 仅通知，数据不持久化在 IM）
