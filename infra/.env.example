# Postgres
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentic-insight

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_BUCKET=cases-media

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM keys (fill in real values, never commit)
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=

# Douyin / Juliang (fill in via OAuth flow)
DOUYIN_OAUTH_CLIENT_ID=
DOUYIN_OAUTH_CLIENT_SECRET=
QIANCHUAN_API_KEY=

# v6 feature flags
POC_CRAWLED_ENABLED=true        # MUST be false in production deploy
POC_DATA_TTL_DAYS=30
HITL_WEBHOOK_URL=               # IM bot webhook for hitl_alerts notification
