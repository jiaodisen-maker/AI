[Unit]
Description=Agentic Insight API (FastAPI uvicorn)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/opt/agentic-insight
EnvironmentFile=/opt/agentic-insight/infra/.env
ExecStart=/opt/agentic-insight/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
