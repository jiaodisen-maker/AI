{
  "title": "Agentic Insight",
  "uid": "agentic-insight-main",
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Open Alerts (total)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(agentic_open_alerts)" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "PoC Pending Purge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "agentic_poc_pending_purge" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Cases",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(agentic_cases_total)" }]
    },
    {
      "type": "stat",
      "title": "DSPy Versions",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(agentic_dspy_prompt_versions)" }]
    },
    {
      "type": "barchart",
      "title": "Cases by Lineage",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "agentic_cases_total", "legendFormat": "{{data_lineage}}" }]
    },
    {
      "type": "barchart",
      "title": "Atoms by Type & Grade",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "agentic_atoms_total", "legendFormat": "{{atom_type}} / {{grade}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Open Alerts by Type",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [
        { "expr": "agentic_open_alerts", "legendFormat": "{{alert_type}}" }
      ]
    },
    {
      "type": "barchart",
      "title": "Microtypes by Status",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "agentic_microtypes_total", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
