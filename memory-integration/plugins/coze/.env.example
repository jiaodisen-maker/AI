# 复制为 .env，填好后 docker-compose up
# .env 已在 .gitignore，不要 commit

# Coze 调你这边时校验的 Bearer。建议用 openssl rand -hex 32 生成
PLUGIN_API_KEY=

# memory-integration 后端怎么调
# stdio  = 进程内调（开发模式，部署在同一容器）
# http   = 走 mcp_server 的 HTTP，填 URL
MEMORY_BACKEND=stdio
MEMORY_HTTP_URL=http://memory-backend:7900

# 限流（per bot_id）
RATE_LIMIT_RECALL_PER_MIN=120
RATE_LIMIT_WRITE_PER_MIN=30
RATE_LIMIT_REFLECT_PER_MIN=2

# 服务监听
BIND_HOST=0.0.0.0
BIND_PORT=8810

# 审计日志路径（不落原文，只落元数据）
AUDIT_LOG=/var/log/coze-plugin/audit.log
